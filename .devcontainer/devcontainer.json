{
  "name": "Joomla MCP Suite",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "mcp-server",
  "workspaceFolder": "/workspaces/joomla-mcp-suite",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Joomla",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "chmod +x scripts/auto_install.sh && echo 'JOOMLA_API_TOKEN=your_token_here' > .env",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
